{
  "name": "context-dev-ai-tools",
  "version": "1.0.0",
  "description": "Community-built Vercel AI SDK tools for the context.dev web data API (unofficial).",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example:smoke": "tsx examples/smoke.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "ai-sdk",
    "vercel-ai-sdk",
    "context.dev",
    "web-scraping",
    "agent-tools",
    "llm-tools"
  ],
  "dependencies": {
    "context.dev": "^2.14.0"
  },
  "peerDependencies": {
    "ai": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.46",
    "@types/node": "^22.10.0",
    "ai": "^7.0.85",
    "dotenv": "^16.4.7",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  }
}
